#!/bin/sh
# Download the official Tuple for Linux client and place it on the user's PATH.
#
# The plugin runs this with --json and reads one event per line. Nothing here
# runs as root, nothing is executed from the download, and the binary is only
# moved into place after its SHA-256 matches the checksum Tuple publishes
# alongside the release.
#
# Usage: tuple-install [--dest DIR] [--arch x86_64|arm64] [--json] [--check]

set -eu

VERSION_ENDPOINT="https://production.tuple.app/latest_version/linux"
VERSION_ACCEPT="application/tuple.app; version=1"
RELEASE_BASE="https://tuple-client-releases.s3.amazonaws.com/linux"

dest_dir="${HOME}/.local/bin"
arch=""
json=0
check_only=0

while [ $# -gt 0 ]; do
  case "$1" in
    --dest) dest_dir="${2:?--dest needs a directory}"; shift 2 ;;
    --arch) arch="${2:?--arch needs a value}"; shift 2 ;;
    --json) json=1; shift ;;
    --check) check_only=1; shift ;;
    -h|--help)
      echo "Usage: tuple-install [--dest DIR] [--arch x86_64|arm64] [--json] [--check]"
      exit 0 ;;
    *) echo "unknown option: $1" >&2; exit 2 ;;
  esac
done

# Expand a leading ~ so the value can come straight from plugin settings.
case "$dest_dir" in
  "~") dest_dir="$HOME" ;;
  "~/"*) dest_dir="${HOME}/${dest_dir#\~/}" ;;
esac

# NDJSON for the panel, plain prose for a human running this in a terminal.
emit() {
  stage="$1"
  message="$2"
  extra="${3:-}"
  if [ "$json" -eq 1 ]; then
    printf '{"stage":"%s","message":"%s"%s}\n' "$stage" "$message" "$extra"
  else
    printf '%s\n' "$message"
  fi
}

fail() {
  emit error "$1"
  exit 1
}

need() {
  command -v "$1" >/dev/null 2>&1 || fail "$1 is required but was not found on PATH"
}

need curl

sha_tool=""
if command -v sha256sum >/dev/null 2>&1; then
  sha_tool="sha256sum"
elif command -v shasum >/dev/null 2>&1; then
  sha_tool="shasum -a 256"
else
  fail "sha256sum or shasum is required to verify the download"
fi

if [ -z "$arch" ]; then
  machine="$(uname -m)"
  case "$machine" in
    x86_64|amd64) arch="x86_64" ;;
    aarch64|arm64) arch="arm64" ;;
    *) fail "unsupported architecture: $machine" ;;
  esac
fi

emit resolve "Checking the latest Tuple release"

manifest="$(curl -fsSL -H "Accept: ${VERSION_ACCEPT}" "${VERSION_ENDPOINT}?arch=${arch}" 2>/dev/null)" \
  || fail "could not reach Tuple's release service"

# The endpoint answers {"version":…,"sha256":…,"url":…}. Parse without jq so
# the plugin has no dependency beyond curl.
field() {
  printf '%s' "$manifest" | sed -n "s/.*\"$1\"[[:space:]]*:[[:space:]]*\"\([^\"]*\)\".*/\1/p"
}

version="$(field version)"
checksum="$(field sha256)"
url="$(field url)"

[ -n "$version" ] || fail "release service did not report a version for ${arch}"
[ -n "$checksum" ] || fail "release service did not report a checksum for ${version}"
[ -n "$url" ] || url="${RELEASE_BASE}/${version}/${arch}/tuple"

case "$url" in
  https://tuple-client-releases.s3.amazonaws.com/*|https://production.tuple.app/*) ;;
  *) fail "refusing to download from an unexpected host" ;;
esac

if [ "$check_only" -eq 1 ]; then
  emit done "Latest Tuple for Linux is ${version}" ",\"version\":\"${version}\""
  exit 0
fi

dest="${dest_dir%/}/tuple"
mkdir -p "$dest_dir" || fail "could not create ${dest_dir}"
[ -w "$dest_dir" ] || fail "${dest_dir} is not writable"

work="$(mktemp -d "${TMPDIR:-/tmp}/tuple-install.XXXXXX")" || fail "could not create a temporary directory"
trap 'rm -rf "$work"' EXIT INT TERM
payload="${work}/tuple"

emit download "Downloading Tuple ${version} (${arch})" ",\"version\":\"${version}\""
curl -fL --retry 2 --connect-timeout 20 "$url" -o "$payload" 2>/dev/null \
  || fail "download failed from ${url}"

emit verify "Verifying checksum"
actual="$($sha_tool "$payload" | cut -d' ' -f1)"
if [ "$actual" != "$checksum" ]; then
  fail "checksum mismatch: expected ${checksum}, got ${actual}"
fi

emit install "Installing to ${dest}"
# `install` copies and sets the mode in one step; the payload is never run here.
install -m 755 "$payload" "$dest" || fail "could not write ${dest}"

case ":${PATH}:" in
  *":${dest_dir%/}:"*) path_note="" ;;
  *) path_note=" (add ${dest_dir%/} to your PATH)" ;;
esac

emit done "Tuple ${version} installed${path_note}" ",\"version\":\"${version}\",\"path\":\"${dest}\""
