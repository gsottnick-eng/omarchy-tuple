#!/bin/sh
# A scripted stand-in for Tuple for Linux v2026_10_23.0, for reaching states a
# test cannot reach without a real account (signed in, in a call, sharing).
#
# Output is the sanitized fixtures under tests/fixtures/, which are the real
# client's JSON with fake identities. State lives in $FAKE_TUPLE_STATE as marker
# files, and every invocation's argv is appended to $FAKE_TUPLE_STATE/argv so a
# test can assert on exactly what the plugin ran.
#
# Nothing here opens a browser, touches the network, or talks to a real daemon.

set -eu

STATE="${FAKE_TUPLE_STATE:?FAKE_TUPLE_STATE must point at a state directory}"
FIXTURES="$(cd "$(dirname "$0")/../fixtures" && pwd)"
mkdir -p "$STATE"
printf '%s\n' "$*" >> "$STATE/argv"

flag() { [ -f "$STATE/$1" ]; }
set_flag() { : > "$STATE/$1"; }
clear_flag() { rm -f "$STATE/$1"; }
# One JSON document per line, the way --format json streams it.
compact() { tr -d '\n' < "$1"; echo; }
fail() { printf '{"error":"%s"}\n' "$1" >&2; exit 1; }

# The fixture call stream: line 7 is connected and muted, line 8 connected and live.
state_snapshot() {
  if ! flag logged_in; then compact "$FIXTURES/state-signed-out.json"
  elif ! flag in_call; then compact "$FIXTURES/state-idle.json"
  elif flag guest; then compact "$FIXTURES/state-follow-call-guest.jsonl"
  elif flag muted && ! flag picker_cancelled; then sed -n 7p "$FIXTURES/state-follow-call.jsonl"
  else sed -n 8p "$FIXTURES/state-follow-call.jsonl"
  fi
}

# The room list, as a complete snapshot; `busy` means Pairing is occupied.
rooms_snapshot() {
  if flag many; then many_rooms
  elif flag busy; then compact "$FIXTURES/rooms-busy.json"
  else compact "$FIXTURES/rooms.json"
  fi
}

share_event() {
  share=audio
  flag sharing && share=screen
  printf '{"type":"current_call","data":{"local":{"share_state":"%s"}}}\n' "$share"
}

# Print a snapshot whenever it changes, until killed, the daemon is stopped,
# or the test deletes the state directory (and with it the `stopped` flag).
follow() {
  last=""
  while [ -d "$STATE" ] && ! flag stopped; do
    now="$($1)"
    [ "$now" = "$last" ] || { printf '%s\n' "$now"; last="$now"; }
    sleep 0.1
  done
}

# With the `many` flag: a bigger account than the fixtures, to exercise list caps.
many_rooms() {
  printf '['
  i=1
  while [ $i -le 18 ]; do
    fav=false; [ $i -le 4 ] && fav=true
    [ $i -gt 1 ] && printf ','
    # Rooms 2 and 3 are occupied, so large-account renders show occupied rows.
    members='[]'
    if [ $i -eq 2 ] || [ $i -eq 3 ]; then
      members="[{\"id\":$((2000 + i)),\"full_name\":\"Person $i\",\"email\":\"person$i@example.com\"}]"
    fi
    printf '{"slug":"room-%s","name":"Room %s","http_value":"https://tuple.example/c/room-%s","favorited":%s,"members":%s,"kind":"team","active_call":false}' $i $i $i $fav "$members"
    i=$((i + 1))
  done
  printf ']\n'
}

many_contacts() {
  printf '['
  i=1
  while [ $i -le 30 ]; do
    [ $i -gt 1 ] && printf ','
    printf '{"id":%s,"email":"person%s@example.com","full_name":"Person %s","short_name":"Person","kind":"teammate","favorited":false,"recent":false,"status":"unknown"}' $((2000 + i)) $i $i
    i=$((i + 1))
  done
  printf ']\n'
}

need_login() { flag logged_in || fail "not signed in"; }
need_call() { flag in_call || fail "not in a call"; }

case "$*" in
  "--help")
    if flag no_share; then grep -v -E '^\s+(un)?share\s' "$FIXTURES/help.txt"
    else cat "$FIXTURES/help.txt"; fi ;;
  "start") clear_flag stopped; echo "Tuple started. Run tuple to see available commands." ;;
  "stop") set_flag stopped; echo "exiting" ;;
  "state follow --format json") clear_flag stopped; follow state_snapshot ;;
  "state follow --raw --format json") follow share_event ;;
  "contacts follow --format json") need_login; if flag many; then many_contacts; else compact "$FIXTURES/contacts.json"; fi; while [ -d "$STATE" ] && ! flag stopped; do sleep 0.2; done ;;
  "rooms follow --format json") need_login; clear_flag stopped; follow rooms_snapshot ;;
  "login") cat "$FIXTURES/login.txt"; set_flag login_pending ;;
  "logout") clear_flag logged_in; clear_flag in_call ;;
  "call start "*|"call join "*|"rooms join "*|"call accept") need_login; set_flag in_call; echo '{"id":"00000000-0000-4000-8000-000000001001"}' ;;
  "call leave") need_call; clear_flag in_call; clear_flag muted; clear_flag sharing; echo "Left call" ;;
  "call mute") need_call; set_flag muted; echo "Muted" ;;
  "call unmute") need_call; clear_flag muted; echo "Unmuted" ;;
  "share") need_call; flag picker_holds || set_flag sharing; echo "screen share initiated" ;;
  "unshare") need_call; clear_flag sharing; echo "success" ;;
  "contacts favorite "*|"contacts unfavorite "*|"rooms favorite "*|"rooms unfavorite "*) need_login ;;
  *) fail "fake-tuple: unhandled command: $*" ;;
esac
