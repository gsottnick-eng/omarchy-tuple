{
  "schemaVersion": 1,
  "id": "io.github.gsottnick.omatuple",
  "name": "Omatuple",
  "version": "2.6.2",
  "author": "Gavin Sottnick",
  "license": "MIT",
  "description": "Omatuple installs Tuple and runs pair programming from the Omarchy bar: rooms, people, and call controls in one dropdown.",
  "kinds": [
    "bar-widget"
  ],
  "entryPoints": {
    "barWidget": "Panel.qml"
  },
  "barWidget": {
    "displayName": "Omatuple",
    "description": "Sign in, call a teammate, join a room, and control screen sharing without leaving the bar.",
    "category": "Communication",
    "allowMultiple": false,
    "defaultSection": "right",
    "defaults": {
      "barStyle": "icon",
      "panelSize": "normal",
      "accent": "theme",
      "showRooms": true,
      "showPeople": true,
      "callAlerts": true,
      "warnBeforeSharing": true,
      "soundParticipants": true,
      "soundCall": true,
      "soundMute": true,
      "soundShare": true
    },
    "schema": [
      {
        "key": "barStyle",
        "type": "enum",
        "label": "Next to the bar icon: nothing, call status, or who you're in a call with",
        "options": [
          "icon",
          "status",
          "who"
        ],
        "defaultValue": "icon"
      },
      {
        "key": "panelSize",
        "type": "enum",
        "label": "Panel size",
        "options": [
          "compact",
          "normal",
          "tall"
        ],
        "defaultValue": "normal"
      },
      {
        "key": "accent",
        "type": "enum",
        "label": "Highlight colour, from the theme",
        "options": [
          "theme",
          "foreground",
          "urgent"
        ],
        "defaultValue": "theme"
      },
      {
        "key": "showRooms",
        "type": "boolean",
        "label": "Show rooms",
        "defaultValue": true
      },
      {
        "key": "showPeople",
        "type": "boolean",
        "label": "Show people",
        "defaultValue": true
      },
      {
        "key": "callAlerts",
        "type": "boolean",
        "label": "Notify when a call starts or ends",
        "defaultValue": true
      },
      {
        "key": "soundParticipants",
        "type": "boolean",
        "label": "Sound when someone joins or leaves the call",
        "defaultValue": true
      },
      {
        "key": "soundCall",
        "type": "boolean",
        "label": "Sound when your call starts or ends",
        "defaultValue": true
      },
      {
        "key": "soundMute",
        "type": "boolean",
        "label": "Sound when you mute or unmute",
        "defaultValue": true
      },
      {
        "key": "soundShare",
        "type": "boolean",
        "label": "Sound when your screen share starts or stops",
        "defaultValue": true
      },
      {
        "key": "warnBeforeSharing",
        "type": "boolean",
        "label": "Warn before sharing your screen (sharing crashes X11 apps)",
        "defaultValue": true
      }
    ]
  }
}
